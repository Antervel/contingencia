# Baseline prototype Postfix configuration (hand-written, ticket E1-04).
#
# Backup mail server behaviour: accept mail for the client domains and relay
# it to the fake main sink (Mailpit) at [main]:1025, no MX lookup, no copies yet
# (the copy rule is ticket E1-05).

myhostname = backup.client.test
mydomain = client.test
myorigin = client.test

inet_interfaces = all
inet_protocols = ipv4

# No local mail delivery beyond this host name.
mydestination = backup.client.test

# Relay domains and transport: relay client domains to the fake sink.
relay_domains = texthash:/config/postfix/relay_domains
transport_maps = texthash:/config/postfix/transport

# Internal mailbox domain L (copies.invalid), delivered over LMTP to imap.
virtual_mailbox_domains = copies.invalid
virtual_mailbox_maps = texthash:/config/postfix/virtual_mailboxes
virtual_transport = lmtp:inet:imap:24

# Copy rule (ticket E1-05, hypothesis H1): relayed mail also gets a BCC copy
# delivered to the internal address. The catch-all is added in ticket E1-06.
recipient_bcc_maps = texthash:/config/postfix/recipient_bcc

# Recipient policy (ticket E1-06, hypothesis H10): listed relay recipients.
relay_recipient_maps = texthash:/config/postfix/relay_recipients

# Queue lifetimes: 100 days.
maximal_queue_lifetime = 100d
bounce_queue_lifetime = 100d

# No TLS in the prototype; submission and spam/virus/DKIM come later.
smtpd_tls_security_level = none

# Unauthenticated clients may relay only to the relay domains; anything else is
# deferred (authenticated submission is set up in E1-08).
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, defer_unauth_destination

maillog_file = /dev/stdout

# Authenticated submission (ticket E1-08, hypothesis H9): SASL authentication
# against the Dovecot container over the private network (auth listener on the
# imap service, TCP port 12345; not published to the host).
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:imap:12345
smtpd_sasl_security_options = noanonymous

# Sender login enforcement (ticket E1-08, hypothesis H9): sender -> login map,
# enforced on the submission service via reject_sender_login_mismatch (master.cf).
smtpd_sender_login_maps = texthash:/config/postfix/sender_login

# Rate limit window (ticket E1-08): one second per anvil rate time unit, so the
# submission service rate limit of 1 message per second is expressed in seconds.
anvil_rate_time_unit = 1s
